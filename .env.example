# Copy to .env and edit. run.sh reads .env before it starts the server.
# Every line is optional; the value shown is the default unless the comment says otherwise.

# Clients must send "Authorization: Bearer <this>". Empty = no authentication (only for a private network).
# Make one with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ASSISTANT_API_KEY=

PORT=8010

# Language model (Ollama). The rule-based commands work without it.
OLLAMA_URL=http://localhost:11434
# On the DGX Spark: LLM_MODEL=gemma4:12b (more accurate about anatomy, about 1.5 s per answer instead of 1 s)
# and LLM_KEEP_ALIVE=24h (loading the model takes about 16 s). See docs/SPARK_NOTES.md.
LLM_MODEL=gemma4:e4b
LLM_TIMEOUT_S=25
LLM_KEEP_ALIVE=1h
# LLM_WARMUP=0      do not load the model when the server starts
# FAKE_LLM=1        no Ollama at all: the "LLM" echoes the sentence (for testing the HTTP path)

# Speech to text (faster-whisper)
STT_MODEL=base.en
STT_DEVICE=cpu
STT_COMPUTE=int8
# STT_MODEL_DIR=    where the Whisper model is stored (default: the Hugging Face cache in the home folder)
# STT_PROMPT: a few words that bias Whisper towards the app's vocabulary (default: none).
# Measured on a Mac with 33 synthetic clips (macOS "say"): base.en wrote 26 of them exactly without a
# prompt and 31 with the line below ("Pause." instead of "Cause", "semitendinosus", "lats", "Bones.").
# It also turned "psoas major" into "soleus major", which is in the prompt. Try it with real voices
# before leaving it on. See docs/SERVER.md.
# STT_PROMPT="Commands for an anatomy viewer: pause, play, zoom in, pose estimation, muscle layer, skeleton. Muscles and bones: biceps brachii, biceps femoris, semitendinosus, semimembranosus, gastrocnemius, soleus, sartorius, tibialis anterior, gluteus maximus, deltoid, trapezius, lats, femur, tibia, humerus, patella."

# Keep the last uploaded clip as last_voice.wav, to hear what the client sent. 0 = do not keep it.
SAVE_LAST_AUDIO=1

# CATALOG_CACHE_DIR=   where catalogs are cached (default: .cache/catalogs in this folder)
# SESSION_TURNS=6      how many past turns per session the LLM sees
